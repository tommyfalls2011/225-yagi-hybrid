+def _phi_indices_in_sector(center_phi_deg, halfwidth_deg):
+    cols = []
+    for ip in range(_RP_NPHI):
+        phi = (_RP_PHI0_DEG + ip * _RP_DPHI_DEG) % 360.0
+        delta = abs((phi - (center_phi_deg % 360.0) + 180.0) % 360.0 - 180.0)
+        if delta <= halfwidth_deg + 1e-9:
+            cols.append(ip)
+    return cols
