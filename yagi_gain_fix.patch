+# ---------------------------------------------------------------------------
+# Radiation-pattern / gain reading.
+#
+# The installed necpp build exposes:
+#     nec_gain(nec, freq_idx, theta_idx, phi_idx)  -> total power gain in dBi
+#     nec_gain_max(nec, freq_idx), nec_gain_mean(...), ...
+# A radiation pattern must first be requested with an RP card.  We run ONE full
+# upper-hemisphere RP sweep per geometry and read every grid point back - this
+# is both correct and far faster than a separate solve per (elev, azimuth).
+# ---------------------------------------------------------------------------
+
+# Upper-hemisphere sampling grid.
+_RP_THETA0_DEG = 0.0      # theta measured down from the zenith (+Z)
+_RP_DTHETA_DEG = 5.0
+_RP_NTHETA = 19           # 0..90 deg -> horizon at the last row
+_RP_PHI0_DEG = 0.0
+_RP_DPHI_DEG = 5.0
+_RP_NPHI = 72             # 0..355 deg
+
+# The Yagi boom lies along +Y, so the main beam fires toward phi = 90 deg.
+_FWD_PHI_DEG = 90.0
+_REAR_PHI_DEG = 270.0
+_FB_SECTOR_HALFWIDTH_DEG = 30.0   # +/- window around forward / rear azimuth
+
+
+def _pattern_ground_variants(use_real_ground):
+    # Real-ground patterns are what we want; the trailing fallbacks only matter
+    # if a particular necpp build refuses a finite pattern for that ground model.
+    if use_real_ground:
+        return ["real2", "real0", "perfect", "free"]
+    return ["free"]
 
 
