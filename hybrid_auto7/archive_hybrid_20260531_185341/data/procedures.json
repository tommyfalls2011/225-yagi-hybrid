    "full_hybrid_from_seed": {
      "name": "Full Hybrid Tune from Cell Seed",
      "category": "full",
      "description": "Uses latest tuned cell seed (XFRMR+DE+COUPLER locked) and tunes REF + N directors around it. Scores on real_gain + F/B + SWR every iteration.",
      "entry": "./learn_from_cell_seed.py",
      "default_args": {
        "--cell-seed": "data/cell_learning_runs/best_cell_seed.json"
