    "cell_only_match": {
      "name": "Cell-only Match Tune",
      "category": "cell",
      "description": "Tunes XFRMR + DE + COUPLER for best impedance match. Starts DE at 60\", finds spacing sweet spot, then lengths, DE-only move, fine nudges.",
      "entry": "./learn_cell_only.py",
      "default_args": {},
      "editable_params": {
        "de_start_in": {
          "label": "Starting DE position (in)",
          "default": 60.0,
          "min": 36.0,
          "max": 96.0,
          "step": 1.0
        },
        "xfrmr_spacing": {
          "label": "Initial XFRMR spacing behind DE (in)",
          "default": 13.0,
          "min": 4.0,
          "max": 36.0,
          "step": 0.5
        },
        "coupler_spacing": {
          "label": "Initial COUPLER spacing ahead of DE (in)",
          "default": 13.0,
          "min": 4.0,
          "max": 36.0,
          "step": 0.5
        },
        "boom_ft": {
          "label": "Boom length (ft)",
          "default": 18.0,
          "min": 12.0,
          "max": 36.0,
          "step": 0.5
        }
      },
      "stages": [
        "stage1_xsp",
        "stage2_csp",
        "stage3_de_pos",
        "stage4_x_len",
        "stage5_c_len",
        "stage6_de_len",
        "stage7_de_only_move",
        "stage8_nudges"
      ],
      "target_metrics": {
        "max_swr": 1.5,
        "center_r_tol": 5.0,
        "center_x_tol": 5.0
      }
    },
    "cell_cascade": {
      "name": "Cell Cascade (DE \u2192 +XFRMR \u2192 +COUPLER)",
      "category": "cell",
      "description": "Research procedure: Phase 1 DE-only resonance, Phase 2 add XFRMR to drive R\u219250, Phase 3 add COUPLER to drive |X|\u21920. Only overwrites best_cell_seed.json if it beats existing score.",
