          "default": 48.0,
          "min": 36.0,
          "max": 96.0,
          "step": 1.0
        },
        "force_promote": {
          "label": "Force promote (allow XFRMR>DE if NEC says so)",
          "default": false,
          "type": "bool"
        }
      },
      "stages": [
        "phase1_de_resonance",
        "phase2_add_xfrmr_R50",
        "phase3_add_coupler_X0"
      ],
      "target_metrics": {
        "max_swr": 1.5
      }
    },
