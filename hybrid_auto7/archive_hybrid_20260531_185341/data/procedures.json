          "label": "Number of directors",
          "default": 4,
          "min": 1,
          "max": 8,
          "step": 1
        },
        "priority": {
          "label": "Priority",
          "default": "balanced",
          "choices": [
            "balanced",
            "gain",
            "swr"
          ]
        }
      },
      "stages": [
